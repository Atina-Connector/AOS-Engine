# macOS
.DS_Store

# Build/packaging outputs — regenerated by scripts/CI, never versioned
build/*
!build/.gitkeep
dist/*
!dist/.gitkeep
downloads/
tmp/

# Release artifacts (built by CI, uploaded as artifacts/releases, not committed)
*.exe
*.msi
*.msix
AOS-Portable-*.zip
AOS-Setup-*

# Docker/dev runtime data (bind-mounted into the container; auto-created)
runtime/*
!runtime/README.md

# Logs and user-generated reports/data
*.log
logs/

# Temporary safety-net copy of app/ kept during the Git history migration
# (see docs/distribution/REPOSITORY_LAYOUT.md) — delete manually once the
# migration is confirmed good; never meant to be committed.
/app.source-of-truth/
